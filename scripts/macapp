#!/usr/bin/env bash
# Build dist/Blanca.app: a universal bundle whose executable is the blanca binary. Opened
# from Finder it runs `blanca watch`. Also dist/Blanca.dmg, the app beside an Applications
# shortcut to drag it onto. Usage: scripts/macapp [version]
#
# Signed ad hoc unless BLANCA_SIGN names a Developer ID Application identity. Give its
# SHA-1 from `security find-identity -v -p codesigning` rather than its name: a name with
# a letter like ç in it does not survive the trip through the shell. With BLANCA_NOTARY,
# a profile saved by `xcrun notarytool store-credentials`, the app and the dmg are
# notarised and stapled as well.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
ver=${1:-0.0.0}
sign=${BLANCA_SIGN:--}
notary=${BLANCA_NOTARY:-}
[[ -z $notary || $sign != - ]] || { echo "BLANCA_NOTARY needs BLANCA_SIGN" >&2; exit 1; }
export MACOSX_DEPLOYMENT_TARGET=13.0 # SMAppService, the login item, needs macOS 13
app=dist/Blanca.app
rm -rf "$app" dist/Blanca.iconset
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" dist/Blanca.iconset

for arch in amd64 arm64; do
  CGO_ENABLED=1 GOOS=darwin GOARCH=$arch go build -trimpath -ldflags "-s -w -X main.version=$ver" -o "dist/blanca-$arch" .
done
lipo -create -output "$app/Contents/MacOS/blanca" dist/blanca-amd64 dist/blanca-arm64
rm dist/blanca-amd64 dist/blanca-arm64

for s in 16 32 128 256; do
  sips -z $s $s assets/png/blanca-tile-512.png --out "dist/Blanca.iconset/icon_${s}x${s}.png" >/dev/null
  sips -z $((s * 2)) $((s * 2)) assets/png/blanca-tile-512.png --out "dist/Blanca.iconset/icon_${s}x${s}@2x.png" >/dev/null
done
cp assets/png/blanca-tile-512.png dist/Blanca.iconset/icon_512x512.png
iconutil -c icns -o "$app/Contents/Resources/Blanca.icns" dist/Blanca.iconset
rm -rf dist/Blanca.iconset

cat > "$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>Blanca</string>
	<key>CFBundleIdentifier</key><string>com.github.ezapmar.blanca</string>
	<key>CFBundleExecutable</key><string>blanca</string>
	<key>CFBundleIconFile</key><string>Blanca</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$ver</string>
	<key>CFBundleVersion</key><string>$ver</string>
	<key>LSMinimumSystemVersion</key><string>13.0</string>
	<key>LSUIElement</key><true/>
	<key>LSMultipleInstancesProhibited</key><true/>
	<key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
EOF
if [[ $sign == - ]]; then
  codesign --force --sign - "$app"
else
  codesign --force --options runtime --timestamp --sign "$sign" "$app"
fi
if [[ -n $notary ]]; then
  ditto -c -k --keepParent "$app" dist/Blanca-notarise.zip
  xcrun notarytool submit dist/Blanca-notarise.zip --keychain-profile "$notary" --wait
  rm dist/Blanca-notarise.zip
  xcrun stapler staple "$app"
fi

rm -rf dist/dmg dist/Blanca.dmg
mkdir dist/dmg
cp -R "$app" dist/dmg/
ln -s /Applications dist/dmg/Applications
hdiutil create -quiet -volname Blanca -srcfolder dist/dmg -format UDZO dist/Blanca.dmg
rm -rf dist/dmg
if [[ $sign != - ]]; then
  codesign --timestamp --sign "$sign" dist/Blanca.dmg
fi
if [[ -n $notary ]]; then
  xcrun notarytool submit dist/Blanca.dmg --keychain-profile "$notary" --wait
  xcrun stapler staple dist/Blanca.dmg
fi
echo "$app"
