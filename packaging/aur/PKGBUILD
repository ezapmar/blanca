# Maintainer: Tunca Üçer (https://github.com/ezapmar)
pkgname=blanca-bin
pkgver=0.1.2
pkgrel=1
pkgdesc="Clipboard history bezel for Omarchy and Hyprland, a Go port of Jumpcut"
arch=('x86_64' 'aarch64')
url="https://github.com/ezapmar/blanca"
license=('MIT')
depends=('wl-clipboard' 'wtype' 'xdg-terminal-exec')
optdepends=('hyprland: keybinding, autostart and floating window rules')
provides=('blanca')
conflicts=('blanca')
options=('!strip')
source_x86_64=("${url}/releases/download/v${pkgver}/blanca-v${pkgver}-linux-amd64.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/blanca-v${pkgver}-linux-arm64.tar.gz")
sha256sums_x86_64=('713ba11d324e20470091b646999030455208e0552d805d777d5fce29a9624429')
sha256sums_aarch64=('dd39776519717ad42225f580ed981fbc32cdd0ae38d77d9b99cb940442d364ed')

package() {
  local goarch=amd64
  [[ $CARCH == aarch64 ]] && goarch=arm64
  cd "${srcdir}/blanca-v${pkgver}-linux-${goarch}"
  install -Dm755 blanca "${pkgdir}/usr/bin/blanca"
  install -Dm644 assets/blanca.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/blanca.svg"
  install -Dm644 assets/blanca-tile.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/blanca-tile.svg"
  install -Dm644 assets/blanca-symbolic.svg "${pkgdir}/usr/share/icons/hicolor/symbolic/apps/blanca-symbolic.svg"
  install -Dm644 assets/blanca.desktop "${pkgdir}/usr/share/applications/blanca.desktop"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
